{
  "name": "us-navy-collection",
  "version": "0.1.0",
  "description": "美舰收藏 - 基于舰队收藏机制的美国海军舰娘仿品网页游戏",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "art": "node scripts/generate_art.js",
    "art-ai": "node scripts/generate_ai_art.js",
    "sim": "node scripts/simulate.js",
    "sim:soak": "node scripts/sim_soak.js",
    "test": "node scripts/simulate.js",
    "test:migration": "node scripts/test_save_migration.js",
    "test:e2e": "node scripts/e2e.js",
    "smoke:account": "node scripts/smoke_account.js",
    "drift": "node scripts/drift_check.js --against scripts/battle_digest.baseline.txt",
    "drift:v0305": "node scripts/drift_check.js --no-support --against scripts/battle_digest.baseline_v0305.txt",
    "drift:sup": "node scripts/drift_check.js --with-support --against scripts/battle_digest.baseline_v0306_support.txt",
    "drift:v0302": "node scripts/drift_check.js --no-hist --no-waves --against scripts/battle_digest.baseline_v0302.txt",
    "drift:archive": "node scripts/drift_check.js --no-touch --no-hist --no-waves --against scripts/battle_digest.baseline_v0301.txt",
    "probe:recon": "node scripts/probe_recon_variance.js",
    "diff:maps": "node scripts/map_difficulty.js 300",
    "shot": "node scripts/shot.js",
    "admin": "node scripts/create_admin.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
